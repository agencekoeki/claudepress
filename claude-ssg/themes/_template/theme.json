{
    "name": "_template",
    "version": "1.0.0",
    "description": "Template de base pour créer un nouveau thème",
    "author": "Claude SSG",
    "colors": {
        "primary": "#007bff",
        "secondary": "#6c757d",
        "success": "#28a745",
        "danger": "#dc3545",
        "warning": "#ffc107",
        "info": "#17a2b8",
        "light": "#f8f9fa",
        "dark": "#343a40",
        "background": "#ffffff",
        "text": "#212529"
    },
    "typography": {
        "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "fontFamilyMono": "'SF Mono', Monaco, 'Courier New', monospace",
        "baseFontSize": "16px",
        "lineHeight": "1.5"
    },
    "spacing": {
        "unit": "8px",
        "small": "8px",
        "medium": "16px",
        "large": "32px",
        "xlarge": "64px"
    },
    "breakpoints": {
        "mobile": "576px",
        "tablet": "768px",
        "desktop": "992px",
        "wide": "1200px"
    }
}
