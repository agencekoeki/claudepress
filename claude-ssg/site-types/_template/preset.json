{
  "name": "Site Type Name",
  "version": "1.0.0",
  "description": "Description du type de site",

  "defaultTheme": "minimal",

  "requiredPages": [
    "index"
  ],

  "optionalPages": [
    "about",
    "contact"
  ],

  "navigation": {
    "maxItems": 5,
    "showCta": false
  },

  "components": [
    "hero",
    "features",
    "cta-section"
  ],

  "contentTypes": {
    "page": {
      "fields": ["title", "description", "layout"]
    }
  },

  "build": {
    "generateSitemap": true,
    "generateRobots": true,
    "generate404": true
  }
}
